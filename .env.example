# Copy to .env. Never commit or send the token to the browser.
# Connection and credentials are configured only here, never in the browser.
CONNECTION_MODE=home_assistant
# Used when CONNECTION_MODE=mammotion (account email/phone and password).
MAMMOTION_USERNAME=
MAMMOTION_PASSWORD=
# Optional exact device name; required when the account contains multiple mowers.
MAMMOTION_DEVICE=
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=
# Optional explicit entity; otherwise auto-select a single discovered mower.
MOWER_ENTITY=
ALLOW_MANUAL_MOVEMENT=false
# Optional direct-account Bluetooth movement. Requires a host Bluetooth adapter.
BLUETOOTH_ENABLED=false
BLUETOOTH_ADDRESS=
AUTO_CAPTURE=true
CAPTURE_INTERVAL=300
PORT=5000
BIND_ADDRESS=0.0.0.0
# Set for reverse proxy requests whose Origin differs from the backend Host.
APP_ORIGIN=
# Optional read-only cache: use docker-compose.ha-cache.yml override.
HA_HOST_CONFIG_PATH=/home/pi/.homeassistant
# On Debian, enable optional mount persistently for all compose commands:
# COMPOSE_FILE=docker-compose.yml:docker-compose.ha-cache.yml
# Native development only (compose sets DATA_DIR=/data).
DATA_DIR=data

# Telegram token stays server-side; enable notifications and configure chat/user IDs in Settings.
TELEGRAM_BOT_TOKEN=
# Optional trusted HTTP(S) endpoint returning a real JPEG/PNG frame for unattended notifications.
# Mammotion-HA camera_proxy is a placeholder, not a real snapshot.
CAMERA_SNAPSHOT_URL=

# On-demand server-side camera viewer for Telegram when no recent browser frame exists.
TELEGRAM_CAMERA_CAPTURE=true

# Use the Mammotion account MQTT state stream alongside HA (requires account credentials).
MQTT_TELEMETRY_ENABLED=true

# Optional visual map alignment (metres, signed). Does not change saved GPS/maps.
# MAP_OFFSET_LAT: positive north / negative south.
# MAP_OFFSET_LON: positive east / negative west.
# Requires container restart after changes.
MAP_OFFSET_LAT=0
MAP_OFFSET_LON=0
